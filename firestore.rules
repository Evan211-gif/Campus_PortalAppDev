
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // USER ROLE HELPERS
    // ==========================================

    function isLoggedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return isLoggedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userRole() == 'admin';
    }

    function isTeacher() {
      return isLoggedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userRole() == 'teacher';
    }

    function isStudent() {
      return isLoggedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userRole() == 'student';
    }

    // ==========================================
    // CLUB OWNERSHIP
    // ==========================================

    function advisorOwnsClub(clubId) {
      return isTeacher()
        && exists(
          /databases/$(database)/documents/clubs/$(clubId)
        )
        && get(
          /databases/$(database)/documents/clubs/$(clubId)
        ).data.advisorId == request.auth.uid;
    }

    // ==========================================
    // TEACHER MEMBERSHIP SUMMARY VALIDATION
    // ==========================================

    function teacherManagesMembershipSummary(studentId) {
      let requestId = request.resource.data.managedRequestId;
      let clubId = request.resource.data.managedClubId;
      let requestPath =
        /databases/$(database)/documents/club_membership_requests/$(requestId);

      return isTeacher()
        && requestId is string
        && clubId is string
        && existsAfter(requestPath)
        && getAfter(requestPath).data.studentId == studentId
        && getAfter(requestPath).data.clubId == clubId
        && (
          (
            get(requestPath).data.status == 'pending'
            && getAfter(requestPath).data.status in [
              'approved',
              'rejected'
            ]
          )
          ||
          (
            get(requestPath).data.status == 'approved'
            && getAfter(requestPath).data.status == 'removed'
          )
        )
        && advisorOwnsClub(clubId);
    }

    // ==========================================
    // VALIDATE TEACHER ASSIGNMENT
    // ==========================================

    function validAdvisorAssignment() {
      return request.resource.data.advisorId == ''
        || (
          request.resource.data.advisorId is string
          && exists(
            /databases/$(database)/documents/users/$(request.resource.data.advisorId)
          )
          && get(
            /databases/$(database)/documents/users/$(request.resource.data.advisorId)
          ).data.role == 'teacher'
        );
    }

    // ==========================================
    // USERS
    // ==========================================

    match /users/{userId} {

      allow get: if isAdmin()
        || (isLoggedIn() && request.auth.uid == userId)
        || isTeacher();

      allow list: if isAdmin();

      // Admin can create Student or Teacher records.
      allow create: if isAdmin()
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.keys().hasAll([
          'firstName',
          'lastName',
          'name',
          'email',
          'role',
          'institutionalId',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'name',
          'email',
          'role',
          'institutionalId',
          'status',
          'createdAt'
        ])
        && request.resource.data.institutionalId is string
        && request.resource.data.institutionalId.matches('^[0-9]{10}$')
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && existsAfter(
          /databases/$(database)/documents/institutional_ids/$(request.resource.data.institutionalId)
        )
        && getAfter(
          /databases/$(database)/documents/institutional_ids/$(request.resource.data.institutionalId)
        ).data.uid == userId
        && getAfter(
          /databases/$(database)/documents/institutional_ids/$(request.resource.data.institutionalId)
        ).data.role == request.resource.data.role;

      // Admin can only change account status and updatedAt.
      allow update: if isAdmin()
        && resource.data.role in ['student', 'teacher']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['active', 'deactivated']
        && request.resource.data.updatedAt is timestamp;

      // Preserve user records; use deactivation instead.
      allow delete: if false;
    }

    // ==========================================
    // UNIQUE SCHOOL / TEACHER ID REGISTRY
    // ==========================================

    match /institutional_ids/{institutionalId} {

      allow get: if isAdmin();

      allow list: if isAdmin();

      allow create: if isAdmin()
        && institutionalId.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasAll([
          'uid',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'role',
          'createdAt'
        ])
        && request.resource.data.uid is string
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.createdAt is timestamp;

      allow update: if false;

      allow delete: if isAdmin()
        && resource.data.uid is string;
    }

    // ==========================================
    // CAMPUS EVENTS
    // ==========================================

    match /events/{eventId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // ROOM ASSIGNMENTS
    // ==========================================

    match /room_assignments/{eventId} {
      allow read: if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // CAMPUS CLUBS
    // ==========================================

    match /clubs/{clubId} {

      allow read: if isAdmin()
        || isTeacher()
        || isStudent();

      // Admin creates approved clubs.
      allow create: if isAdmin()
        && validAdvisorAssignment()
        && request.resource.data.keys().hasAll([
          'name',
          'description',
          'category',
          'advisorId',
          'advisorEmail',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'description',
          'category',
          'advisorId',
          'advisorEmail',
          'status',
          'createdAt'
        ])
        && request.resource.data.status == 'approved';

      // Teacher creates pending clubs assigned to themselves.
      allow create: if isTeacher()
        && request.resource.data.advisorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'name',
          'description',
          'category',
          'advisorId',
          'advisorEmail',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'description',
          'category',
          'advisorId',
          'advisorEmail',
          'status',
          'createdAt'
        ]);

      // Admin updates clubs.
      allow update: if isAdmin()
        && validAdvisorAssignment()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'description',
            'category',
            'advisorId',
            'advisorEmail',
            'status'
          ]);

      // Teacher updates only their own club details.
      allow update: if isTeacher()
        && resource.data.advisorId == request.auth.uid
        && request.resource.data.advisorId == resource.data.advisorId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'description',
            'category'
          ]);

      allow delete: if isAdmin()
        || (
          isTeacher()
          && resource.data.advisorId == request.auth.uid
        );
    }

    // ==========================================
    // CLUB MEMBERSHIP REQUESTS
    // ==========================================

    match /club_membership_requests/{requestId} {

      // READ
      allow get: if isAdmin()
        || (
          isStudent()
          && requestId.matches('.*_' + request.auth.uid)
        )
        || (
          isTeacher()
          && resource.data.clubId != null
          && advisorOwnsClub(resource.data.clubId)
        );

      allow list: if isAdmin()
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        )
        || (
          isTeacher()
          && resource.data.clubId != null
          && advisorOwnsClub(resource.data.clubId)
        );

      // STUDENT CREATES FIRST REQUEST
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && requestId.matches('.*_' + request.auth.uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.attemptCount == 1
        && request.resource.data.keys().hasAll([
          'clubId',
          'studentId',
          'status',
          'attemptCount',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'clubId',
          'studentId',
          'status',
          'attemptCount',
          'createdAt'
        ])
        && exists(
          /databases/$(database)/documents/clubs/$(request.resource.data.clubId)
        )
        && get(
          /databases/$(database)/documents/clubs/$(request.resource.data.clubId)
        ).data.status == 'approved';

      // STUDENT RETRIES A REJECTED OR AVAILABLE REQUEST
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && requestId.matches('.*_' + request.auth.uid)
        && resource.data.status in ['rejected', 'available']
        && request.resource.data.status == 'pending'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.clubId == resource.data.clubId
        && (
          (
            resource.data.status == 'rejected'
            && request.resource.data.attemptCount ==
              resource.data.get('attemptCount', 0) + 1
          )
          ||
          (
            resource.data.status == 'available'
            && request.resource.data.attemptCount ==
              resource.data.get('attemptCount', 0)
          )
        )
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'attemptCount',
            'createdAt'
          ]);

      // ADMIN AND OWNING TEACHER MANAGE REQUEST STATUSES
      allow update: if (
          isAdmin()
          || (
            isTeacher()
            && advisorOwnsClub(resource.data.clubId)
          )
        )
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['status'])
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status in [
              'approved',
              'rejected',
              'already_member'
            ]
          )
          ||
          (
            resource.data.status == 'approved'
            && request.resource.data.status == 'removed'
          )
          ||
          (
            resource.data.status == 'already_member'
            && request.resource.data.status == 'available'
          )
        );

      allow delete: if isAdmin();
    }

    // ==========================================
    // STUDENT MEMBERSHIP SUMMARY
    // ==========================================

    match /student_memberships/{studentId} {

      // Admin, Teacher, and the student can read.
      allow get: if isAdmin()
        || isTeacher()
        || (
          isStudent()
          && request.auth.uid == studentId
        );

      // Only Admin can list summaries.
      allow list: if isAdmin();

      // Students create their own initial summary.
      allow create: if isStudent()
        && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly([
          'pendingCount',
          'approvedClubId',
          'updatedAt'
        ])
        && request.resource.data.pendingCount is int
        && request.resource.data.pendingCount >= 1
        && request.resource.data.pendingCount <= 3
        && request.resource.data.approvedClubId == null;

      // Students can only increment their own pending count.
      allow update: if isStudent()
        && request.auth.uid == studentId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'pendingCount',
            'updatedAt'
          ])
        && request.resource.data.pendingCount is int
        && request.resource.data.pendingCount >= 1
        && request.resource.data.pendingCount <= 3
        && request.resource.data.pendingCount ==
          resource.data.get('pendingCount', 0) + 1
        && resource.data.approvedClubId == null;

      // Admin manages all summaries.
      // Teacher manages summaries only for their own club requests.
      allow create, update: if isAdmin()
        || teacherManagesMembershipSummary(studentId);

      allow delete: if isAdmin();
    }

    // ==========================================
    // CLUB CATEGORIES
    // ==========================================

    match /club_categories/{categoryId} {
      allow read: if isLoggedIn();
      allow write: if false;
    }

    // ==========================================
    // ANNOUNCEMENTS
    // ==========================================

    match /announcements/{announcementId} {

      allow read: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.status == 'published'
          && (isStudent() || isTeacher())
        );

      allow create: if isAdmin()
        && request.resource.data.status == 'published';

      allow update: if isAdmin()
        && request.resource.data.status in [
          'published',
          'archived'
        ];

      // Only Admin can permanently delete archived announcements.
      allow delete: if isAdmin()
        && resource.data.status == 'archived';
    }

    // ==========================================
    // CLASS MANAGEMENT
    // ==========================================

    match /classes/{classId} {

      allow read: if isLoggedIn();

      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // CLASS ENROLLMENTS
    // ==========================================

    match /class_enrollments/{enrollmentId} {

      allow read: if isAdmin()
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // CLUB ACTIVITIES
    // ==========================================

    match /club_activities/{activityId} {

      // Admin can read all activities.
      // Teachers can read approved and pending activities.
      // Students and other logged-in users can read approved only.
      allow get, list: if isAdmin()
        || (
          isTeacher()
          && resource.data.status in ['approved', 'pending']
        )
        || (
          isLoggedIn()
          && resource.data.status == 'approved'
        );

      // Teacher submits an activity for their own approved club.
      allow create: if isTeacher()
        && request.resource.data.keys().hasAll([
          'clubId',
          'clubName',
          'activityTitle',
          'description',
          'advisorId',
          'roomName',
          'date',
          'startTimeMinutes',
          'endTimeMinutes',
          'status',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'clubId',
          'clubName',
          'activityTitle',
          'description',
          'advisorId',
          'roomName',
          'date',
          'startTimeMinutes',
          'endTimeMinutes',
          'status',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.advisorId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && advisorOwnsClub(request.resource.data.clubId)
        && get(
          /databases/$(database)/documents/clubs/$(request.resource.data.clubId)
        ).data.status == 'approved'
        && request.resource.data.status == 'pending'
        && request.resource.data.activityTitle is string
        && request.resource.data.description is string
        && request.resource.data.roomName is string
        && request.resource.data.date is timestamp
        && request.resource.data.startTimeMinutes is int
        && request.resource.data.endTimeMinutes is int
        && request.resource.data.startTimeMinutes >= 0
        && request.resource.data.endTimeMinutes <= 1440
        && request.resource.data.endTimeMinutes >
          request.resource.data.startTimeMinutes
        && request.resource.data.createdAt is timestamp;

    
// Only Admin can approve or reject pending activities.
allow update: if isAdmin()
  && resource.data.status == 'pending'
  && request.resource.data.status in [
    'approved',
    'rejected'
  ]
  && request.resource.data.reviewedBy == request.auth.uid
  && request.resource.data.reviewedAt == request.time
  && request.resource.data.diff(resource.data)
    .affectedKeys()
    .hasOnly([
      'status',
      'reviewedBy',
      'reviewedAt',
      'rejectionReason'
    ])
  && (
    (
      request.resource.data.status == 'rejected'
      && request.resource.data.rejectionReason is string
      && request.resource.data.rejectionReason.size() > 0
    )
    ||
    (
      request.resource.data.status == 'approved'
      && !('rejectionReason' in request.resource.data)
    )
  );


      // Activities cannot be permanently deleted.
      allow delete: if false;
    }

    // ==========================================
    // DENY EVERYTHING ELSE
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}